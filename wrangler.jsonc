// Cloudflare Workers static hosting for the site (no server code).
// Cloudflare runs `npm run build`, then `npx wrangler deploy` uploads ./dist.
// Unknown addresses get dist/404.html; "/work/plinth" and "/work/plinth/" both work.
{
  "name": "dylanprasodjo-portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
